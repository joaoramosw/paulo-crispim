# Identificador público da Google Tag do Google Ads
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18412361171

# Conversão principal (generate_lead). Valor real da conta, usado como
# fallback em src/lib/analytics.ts mesmo se esta variável ficar vazia.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_FORM_LABEL=NI0iCOy9uegcENOr2ctE

# Microconversões opcionais — preencher somente com labels reais copiados do
# Google Ads. Ficam vazias até existirem (evita conversões incorretas).
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_EMAIL_LABEL=

# Measurement ID do GA4 (formato G-XXXXXXXXXX). Não inventado: o site ainda
# não tem uma propriedade GA4 configurada. Preencher quando uma for criada —
# ver docs/TRACKING.md.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
